# ============================================================
# ClipCompress — Frontend Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: .env.local is gitignored (never committed to Git).
# On Vercel / Render frontend, set these in the dashboard under:
#   Project Settings → Environment Variables
# ============================================================

# Backend API URL — used for all frontend → backend API calls.

# Local development (backend running at port 8000):
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Production (live Render backend):
NEXT_PUBLIC_BACKEND_URL=https://clipcompress-backend.onrender.com
