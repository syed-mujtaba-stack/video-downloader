# ============================================================
# ClipCompress — Backend Environment Variables Template
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render (production), set these in the dashboard under
#   Dashboard → Your Service → Environment → Add Environment Variable
# ============================================================

# Server host and port (Render overrides PORT automatically)
HOST=0.0.0.0
PORT=8000

# CORS — allowed frontend origins (comma-separated).
# Use * to allow all (fine for open APIs).
# For production, restrict to your actual frontend domain:
#   ALLOWED_ORIGINS=https://clipcompress.vercel.app,https://www.clipcompress.app
ALLOWED_ORIGINS=*
